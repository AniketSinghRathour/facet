generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Better-Auth models
// These four models are required by Better-Auth for core
// auth functionality.
// ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  // Domain relation: a user can own many events
  events Event[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ─────────────────────────────────────────────────────────
// Domain models
// ─────────────────────────────────────────────────────────

/// An event created by a photographer. Each event maps to
/// a Rekognition collection for face indexing.
model Event {
  id                     String   @id @default(cuid())
  name                   String
  description            String?
  coverImage             String?
  rekognitionCollectionId String  @unique
  ownerId                String
  owner                  User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  photos Photo[]
  searches EventSearch[]

  @@map("event")
}

/// A photo uploaded to an event. Starts as "pending", moves
/// to "indexed" once Lambda processes it via S3→SQS→Lambda.
model Photo {
  id            String      @id @default(cuid())
  eventId       String      @map("event_id")
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  s3KeyOriginal String      @unique @map("s3_key_original")
  r2KeyPreview  String?     @map("r2_key_preview")
  status        PhotoStatus @default(PENDING)
  errorMessage  String?     @map("error_message")
  uploadedAt    DateTime?   @map("uploaded_at")
  indexedAt     DateTime?   @map("indexed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  faces Face[]

  @@map("photos")
}

/// A face detected in a photo by Rekognition, indexed into
/// the event's collection.
model Face {
  id                String   @id @default(cuid())
  photoId           String   @map("photo_id")
  photo             Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  rekognitionFaceId String   @map("rekognition_face_id")
  boundingBox       Json?    @map("bounding_box")
  confidence        Decimal?
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("faces")
}

enum PhotoStatus {
  PENDING @map("pending")
  INDEXED @map("indexed")
  FAILED  @map("failed")
}

/// Analytics record to track attendee searches without capturing PII.
model EventSearch {
  id           String   @id @default(cuid())
  eventId      String   @map("event_id")
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matchesFound Int      @map("matches_found")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("event_searches")
}
