# Copy to .env for local use (e.g. running prisma commands locally).
# Never commit the real .env file. Real values are entered directly into
# the Lambda console's Environment variables screen.

# Neon: dashboard -> your project -> Connection Details -> "Pooled connection"
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Only set this if you deliberately want Rekognition calls to go to a
# different region than the Lambda itself. Leave unset to use the same
# region as the function.
# REKOGNITION_REGION=ap-south-1
