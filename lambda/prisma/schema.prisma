generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Intentionally only the two tables this Lambda touches. The backend's
// schema.prisma (separate project) owns the full picture: users, events,
// photos, faces, matches. Keep these two in sync by hand if you ever
// change their shape.

model Photo {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  s3KeyOriginal String   @map("s3_key_original")
  r2KeyPreview  String?  @map("r2_key_preview")
  status        String   @default("pending")
  errorMessage  String?  @map("error_message")
  uploadedAt    DateTime? @map("uploaded_at")
  indexedAt     DateTime? @map("indexed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  faces         Face[]

  @@map("photos")
}

model Face {
  id                 String   @id @default(uuid())
  photoId            String   @map("photo_id")
  photo              Photo    @relation(fields: [photoId], references: [id])
  rekognitionFaceId  String   @map("rekognition_face_id")
  boundingBox        Json?    @map("bounding_box")
  confidence         Decimal?
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("faces")
}
